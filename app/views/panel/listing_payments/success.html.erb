<%# Igual que en el pago de certificados: el webhook es quien habilita la
    publicación, así que hasta que llegue mostramos "procesando" en vez de dar
    el pago por confirmado. %>
<% confirmed = @listing.present? && @listing.publication_status == "published" %>
<% key = confirmed ? "" : "_processing" %>

<% content_for :title do %>
  <%= I18n.t("panel.listing_payments.success.title#{key}") %>
<% end %>

<% content_for :breadcrumb do %>
  <li><%= link_to I18n.t('panel.listings.index.title'), panel_listings_path %></li>
  <li><%= I18n.t("panel.listing_payments.success.title#{key}") %></li>
<% end %>

<div class="w-full max-w-2xl mx-auto">
  <div class="card border <%= confirmed ? "bg-success/10 border-success/30" : "bg-info/10 border-info/30" %>">
    <div class="card-body text-center">
      <h1 class="card-title text-3xl justify-center <%= confirmed ? "text-success" : "text-info" %>">
        <%= I18n.t("panel.listing_payments.success.title#{key}") %>
      </h1>
      <p class="mt-2"><%= I18n.t("panel.listing_payments.success.description#{key}") %></p>
      <% if @listing.present? %>
        <%= link_to I18n.t('actions.show'), panel_listing_path(@listing), class: "btn btn-soft btn-primary mt-4" %>
      <% else %>
        <%= link_to I18n.t('panel.listings.index.title'), panel_listings_path, class: "btn btn-soft btn-primary mt-4" %>
      <% end %>
    </div>
  </div>
</div>
