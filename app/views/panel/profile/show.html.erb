<% content_for :title do %>
  Mi Perfil
<% end %>

<% content_for :breadcrumb do %>
  <li>Mi Perfil</li>
<% end %>

<div class="w-full">
  <h1 class="font-bold text-4xl my-4">Mi Perfil</h1>
  <p class="mb-4 text-base-content/70">Consulta tus datos personales verificados, el estado de tu cuenta y tu vinculación con la junta de vecinos.</p>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
  <div class="card bg-base-100 shadow-xl">
    <div class="card-body">
      <h2 class="card-title mb-4">Información Personal</h2>

      <p class="text-sm text-base-content/70 mb-4">
        Los datos personales (nombre, RUT, teléfono) están vinculados a tu identidad verificada.
        Si necesitas actualizarlos, deberás realizar un nuevo proceso de verificación.
      </p>

      <dl class="grid gap-4">
        <% if @user.verified_identity %>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <dt class="text-xs uppercase text-base-content/60">Nombres</dt>
              <dd class="font-semibold"><%= @user.verified_identity.first_name %></dd>
            </div>
            <div>
              <dt class="text-xs uppercase text-base-content/60">Apellidos</dt>
              <dd class="font-semibold"><%= @user.verified_identity.last_name %></dd>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <dt class="text-xs uppercase text-base-content/60">RUT</dt>
              <dd class="font-mono"><%= @user.verified_identity.run %></dd>
            </div>
            <div>
              <dt class="text-xs uppercase text-base-content/60">Teléfono</dt>
              <dd><%= @user.verified_identity.phone.presence || "—" %></dd>
            </div>
          </div>
        <% else %>
          <div class="alert alert-info">
            <%= icon("information-circle", class: "w-6 h-6") %>
            <span>Aún no has verificado tu identidad.</span>
          </div>
        <% end %>

        <div>
          <dt class="text-xs uppercase text-base-content/60">Correo Electrónico</dt>
          <dd><%= @user.email %></dd>
          <p class="text-xs text-base-content/50 mt-1">El correo electrónico no puede modificarse.</p>
        </div>
      </dl>

      <div class="divider">Seguridad</div>

      <p class="text-sm text-base-content/70">
        El cambio de contraseña se realiza desde
        <%= link_to "Mi Cuenta", edit_user_registration_path, class: "link link-primary" %>,
        donde se solicita tu contraseña actual.
      </p>
    </div>
  </div>

  <div class="flex flex-col gap-8">
    <div class="card bg-base-100 shadow-xl">
      <div class="card-body">
        <h2 class="card-title mb-4">Estado de la Cuenta</h2>

        <div class="flex items-center gap-4 mb-4">
          <div class="avatar placeholder">
            <div class="bg-neutral text-neutral-content rounded-full w-12">
              <span class="text-xl"><%= @user.verified_identity&.first_name&.first || @user.email.first.upcase %></span>
            </div>
          </div>
          <div>
            <div class="font-bold"><%= @user.email %></div>
            <div class="text-sm opacity-70">Miembro desde <%= l(@user.created_at.to_date) %></div>
          </div>
        </div>

        <% if @user.member.present? %>
          <div class="alert alert-success">
            <%= icon("check-circle", class: "w-6 h-6") %>
            <div>
              <h3 class="font-bold">Vinculado a Junta de Vecinos</h3>
              <div class="text-xs">Estás registrado en <%= @user.member.neighborhood_association.name %></div>
            </div>
          </div>
        <% else %>
          <div class="alert alert-warning">
            <%= icon("exclamation-circle", class: "w-6 h-6") %>
            <div>
              <h3 class="font-bold">Sin Vinculación</h3>
              <div class="text-xs">No perteneces a ninguna Junta de Vecinos activa.</div>
              <%= link_to "Comenzar Onboarding", panel_onboarding_step1_path, class: "btn btn-sm btn-ghost mt-2" %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
</div>
