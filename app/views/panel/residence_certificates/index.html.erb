<% content_for :title do %>
  <%= I18n.t('panel.residence_certificates.index.title') %>
<% end %>

<% content_for :breadcrumb do %>
  <li><%= I18n.t('panel.residence_certificates.index.title') %></li>
<% end %>

<div class="w-full">
  <h1 class="font-bold text-4xl my-4"><%= I18n.t('panel.residence_certificates.index.title') %></h1>
  <p class="mb-4 text-base-content/70"><%= I18n.t('panel.residence_certificates.index.description') %></p>

  <% if @residence_certificates.any? %>
    <div class="flex flex-row gap-2 mb-4">
      <%= link_to raw(icon('new') + I18n.t('actions.new')), new_panel_residence_certificate_path, class: "btn btn-soft btn-primary" %>
    </div>

    <div class="overflow-x-auto rounded-box border border-base-content/5 bg-base-100">
      <table class="table">
        <thead>
          <tr>
            <th><%= I18n.t('activerecord.attributes.residence_certificate.folio') %></th>
            <th><%= I18n.t('activerecord.attributes.residence_certificate.member') %></th>
            <th><%= I18n.t('activerecord.attributes.residence_certificate.status') %></th>
            <th><%= I18n.t('activerecord.attributes.residence_certificate.validity') %></th>
            <th><%= I18n.t('activerecord.attributes.residence_certificate.purpose') %></th>
            <th><%= I18n.t('activerecord.attributes.residence_certificate.created_at') %></th>
          </tr>
        </thead>
        <tbody>
        <% @residence_certificates.each do |certificate| %>
          <tr class="hover:bg-base-300 cursor-pointer"
              data-controller="row-link"
              data-row-link-url-value="<%= panel_residence_certificate_path(certificate) %>"
              data-action="click->row-link#visit">
            <td><%= link_to certificate.folio || "—", panel_residence_certificate_path(certificate), class: "link link-hover font-medium" %></td>
            <td><%= certificate.member.name %></td>
            <td><%= I18n.t("activerecord.attributes.residence_certificate/status.#{certificate.status}") %></td>
            <td>
              <% if certificate.issued? %>
                <% if certificate.expired? %>
                  <span class="badge badge-soft badge-error"><%= I18n.t('activerecord.attributes.residence_certificate/validity.expired') %></span>
                <% else %>
                  <span class="badge badge-soft badge-success"><%= I18n.t('activerecord.attributes.residence_certificate/validity.valid') %></span>
                <% end %>
              <% else %>
                —
              <% end %>
            </td>
            <td><%= truncate(certificate.purpose, length: 50) %></td>
            <td><%= l(certificate.created_at.to_date) %></td>
          </tr>
        <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <%= render "shared/empty_state",
          icon: "id",
          title: I18n.t('panel.residence_certificates.empty.title'),
          description: I18n.t('panel.residence_certificates.empty.description'),
          cta_text: I18n.t('panel.residence_certificates.empty.cta'),
          cta_path: new_panel_residence_certificate_path %>
  <% end %>
</div>
