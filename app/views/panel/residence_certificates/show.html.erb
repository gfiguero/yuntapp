<% content_for :title do %>
  <%= I18n.t('panel.residence_certificates.index.title') %>
<% end %>

<% content_for :breadcrumb do %>
  <li><%= link_to I18n.t('panel.residence_certificates.index.title'), panel_residence_certificates_path %></li>
  <li><%= @residence_certificate.id %></li>
<% end %>

<div class="w-full">
  <h1 class="font-bold text-4xl my-4"><%= I18n.t('panel.residence_certificates.index.title') %></h1>
  <h3 class="font-bold text-xl mb-4"><%= I18n.t('panel.residence_certificates.show.identifier', id: @residence_certificate.id) %></h3>

  <div class="flex flex-row gap-2 mb-4">
    <%= link_to raw(icon('list') + I18n.t('actions.index')), panel_residence_certificates_path, class: "btn btn-soft" %>
  </div>

  <div class="card bg-base-100 shadow-sm border border-base-content/5 max-w-2xl">
    <div class="card-body">
      <div class="flex justify-between items-start">
        <div>
          <p class="text-xs uppercase text-base-content/60"><%= I18n.t('activerecord.attributes.residence_certificate.folio') %></p>
          <p class="font-mono text-lg font-bold"><%= @residence_certificate.folio || "—" %></p>
        </div>
        <div class="flex gap-2">
          <span class="badge badge-soft badge-lg"><%= I18n.t("activerecord.attributes.residence_certificate/status.#{@residence_certificate.status}") %></span>
          <% if @residence_certificate.issued? %>
            <% if @residence_certificate.expired? %>
              <span class="badge badge-soft badge-error badge-lg"><%= I18n.t('activerecord.attributes.residence_certificate/validity.expired') %></span>
            <% else %>
              <span class="badge badge-soft badge-success badge-lg"><%= I18n.t('activerecord.attributes.residence_certificate/validity.valid') %></span>
            <% end %>
          <% end %>
        </div>
      </div>

      <div class="divider my-2"></div>

      <dl class="grid gap-3">
        <div>
          <dt class="text-xs uppercase text-base-content/60"><%= I18n.t('activerecord.attributes.residence_certificate.member') %></dt>
          <dd class="font-semibold text-lg"><%= @residence_certificate.member.name %></dd>
        </div>
        <div>
          <dt class="text-xs uppercase text-base-content/60"><%= I18n.t('activerecord.attributes.residence_certificate.purpose') %></dt>
          <dd><%= @residence_certificate.purpose %></dd>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <dt class="text-xs uppercase text-base-content/60"><%= I18n.t('activerecord.attributes.residence_certificate.issue_date') %></dt>
            <dd><%= @residence_certificate.issue_date ? l(@residence_certificate.issue_date) : "—" %></dd>
          </div>
          <div>
            <dt class="text-xs uppercase text-base-content/60"><%= I18n.t('activerecord.attributes.residence_certificate.expiration_date') %></dt>
            <dd><%= @residence_certificate.expiration_date ? l(@residence_certificate.expiration_date) : "—" %></dd>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <dt class="text-xs uppercase text-base-content/60"><%= I18n.t('activerecord.attributes.residence_certificate.created_at') %></dt>
            <dd><%= l(@residence_certificate.created_at.to_date) %></dd>
          </div>
          <% if @residence_certificate.amount.present? %>
            <div>
              <dt class="text-xs uppercase text-base-content/60"><%= I18n.t('activerecord.attributes.residence_certificate.amount') %></dt>
              <dd>$<%= number_with_delimiter(@residence_certificate.amount) %> CLP</dd>
            </div>
          <% end %>
        </div>
        <% if @residence_certificate.notes.present? %>
          <div>
            <dt class="text-xs uppercase text-base-content/60"><%= I18n.t('activerecord.attributes.residence_certificate.notes') %></dt>
            <dd><%= @residence_certificate.notes %></dd>
          </div>
        <% end %>
      </dl>

      <% if @residence_certificate.pending_payment? && @residence_certificate.amount.present? %>
        <div class="divider my-2"></div>
        <div class="card-actions flex-col">
          <%= link_to I18n.t('panel.payments.actions.pay_with_mercadopago'), new_panel_payment_path(certificate_id: @residence_certificate.id), class: "btn btn-primary btn-lg" %>
          <p class="text-sm text-base-content/70"><%= I18n.t('panel.payments.show.help') %></p>
        </div>
      <% end %>

      <% if @residence_certificate.paid? && !@residence_certificate.issued? %>
        <div class="alert alert-info mt-4">
          <%= I18n.t('panel.residence_certificates.show.processing') %>
        </div>
      <% end %>

      <% if @residence_certificate.issued? %>
        <% if @residence_certificate.downloadable? && @residence_certificate.pdf_document.attached? %>
          <div class="divider my-2"></div>
          <div class="card-actions flex-col">
            <%= link_to I18n.t('panel.residence_certificates.show.download_pdf'), download_panel_residence_certificate_path(@residence_certificate), class: "btn btn-success btn-lg" %>
            <p class="text-sm text-base-content/70">
              <%= I18n.t('panel.residence_certificates.show.validation_code') %>:
              <span class="font-mono font-bold"><%= @residence_certificate.validation_code %></span>
            </p>
          </div>
        <% elsif @residence_certificate.holder_deactivated? %>
          <div class="alert alert-error mt-4">
            <%= I18n.t('panel.residence_certificates.show.holder_deactivated_notice') %>
          </div>
        <% elsif @residence_certificate.expired? %>
          <div class="alert alert-warning mt-4">
            <%= I18n.t('panel.residence_certificates.show.expired_notice') %>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
