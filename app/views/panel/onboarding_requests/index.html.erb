<div class="w-full">
  <h1 class="font-bold text-4xl my-4"><%= I18n.t('panel.onboarding_requests.index.title') %></h1>
  <p class="text-base-content/60 mb-6"><%= I18n.t('panel.onboarding_requests.index.description') %></p>

  <% if @onboarding_requests.empty? %>
    <div class="card bg-base-100 shadow">
      <div class="card-body items-center text-center">
        <p class="text-base-content/70"><%= I18n.t('panel.onboarding_requests.index.empty') %></p>
        <%= link_to I18n.t('panel.onboarding_requests.index.start'), panel_onboarding_step1_path, class: "btn btn-primary mt-2" %>
      </div>
    </div>
  <% else %>
    <div class="grid grid-cols-1 gap-4">
      <% @onboarding_requests.each do |onboarding_request| %>
        <div class="card bg-base-100 shadow">
          <div class="card-body">
            <div class="flex items-start justify-between gap-4">
              <div>
                <h2 class="card-title text-lg">
                  <%= onboarding_request.neighborhood_association&.name || I18n.t('panel.onboarding_requests.index.no_association') %>
                </h2>
                <p class="text-sm text-base-content/60">
                  <%= I18n.t('panel.onboarding_requests.index.created_at', date: l(onboarding_request.created_at.to_date, format: :long)) %>
                </p>
              </div>
              <%= status_badge(onboarding_request.status) %>
            </div>

            <% if onboarding_request.rejection_reason.present? %>
              <div class="alert alert-warning mt-2">
                <div>
                  <p class="font-semibold"><%= I18n.t('panel.onboarding_requests.index.rejection_reason') %></p>
                  <p class="text-sm"><%= onboarding_request.rejection_reason %></p>
                </div>
              </div>
            <% end %>

            <div class="card-actions justify-end mt-2">
              <% if onboarding_request.duplicable? %>
                <%= button_to I18n.t('panel.onboarding_requests.index.duplicate'),
                      panel_onboarding_request_duplicate_path(onboarding_request),
                      method: :post,
                      class: "btn btn-primary btn-sm",
                      data: { turbo_confirm: I18n.t('panel.onboarding_requests.index.duplicate_confirm') } %>
              <% end %>
            </div>

            <% if onboarding_request.duplicable? %>
              <p class="text-xs text-base-content/60">
                <%= I18n.t('panel.onboarding_requests.index.duplicate_help') %>
              </p>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
