<div class="w-full max-w-2xl">
  <h1 class="font-bold text-3xl my-4"><%= t("panel.account_deactivations.new.title") %></h1>

  <div class="alert alert-warning mb-4">
    <span><%= t("panel.account_deactivations.new.warning") %></span>
  </div>

  <p class="mb-4 opacity-80"><%= t("panel.account_deactivations.new.detail") %></p>

  <div class="flex flex-row gap-2">
    <%= link_to t("actions.cancel"), panel_root_path, class: "btn btn-soft" %>
    <%= button_to t("panel.account_deactivations.new.confirm"), panel_account_deactivation_path, method: :post, class: "btn btn-error", data: { turbo_confirm: t("panel.account_deactivations.new.confirm_prompt") } %>
  </div>
</div>
