<%# El pago lo confirma el webhook de MP, que puede no haber llegado cuando MP
    redirige aquí. Mostramos el estado persistido en vez de afirmar el éxito a
    ciegas: un certificado que sigue en `pending_payment` no está pagado. %>
<% confirmed = @certificate.present? && !@certificate.pending_payment? %>
<% key = confirmed ? "" : "_processing" %>

<% content_for :title do %>
  <%= I18n.t("panel.payments.success.title#{key}") %>
<% end %>

<% content_for :breadcrumb do %>
  <li><%= link_to I18n.t('panel.residence_certificates.index.title'), panel_residence_certificates_path %></li>
  <li><%= I18n.t("panel.payments.success.title#{key}") %></li>
<% end %>

<div class="w-full max-w-2xl mx-auto">
  <div class="card border <%= confirmed ? "bg-success/10 border-success/30" : "bg-info/10 border-info/30" %>">
    <div class="card-body text-center">
      <h1 class="card-title text-3xl justify-center <%= confirmed ? "text-success" : "text-info" %>">
        <%= I18n.t("panel.payments.success.title#{key}") %>
      </h1>
      <p class="mt-2"><%= I18n.t("panel.payments.success.description#{key}") %></p>
      <% if @certificate.present? %>
        <%= link_to I18n.t('actions.show'), panel_residence_certificate_path(@certificate), class: "btn btn-soft btn-primary mt-4" %>
      <% else %>
        <%= link_to I18n.t('panel.residence_certificates.index.title'), panel_residence_certificates_path, class: "btn btn-soft btn-primary mt-4" %>
      <% end %>
    </div>
  </div>
</div>
