<div class="flex gap-2 mb-4">
  <%= link_to I18n.t('actions.back'), superadmin_users_path, class: "btn btn-ghost btn-sm" %>
  <% if @user %>
    <%= link_to I18n.t('actions.edit'), edit_superadmin_user_path(@user), class: "btn btn-primary btn-sm" %>
    <% if @user.blocked? %>
      <%= button_to I18n.t('superadmin.users.unblock.action'), unblock_superadmin_user_path(@user), method: :patch, class: "btn btn-warning btn-outline btn-sm" %>
    <% elsif !@user.superadmin? %>
      <%= link_to I18n.t('superadmin.users.block.action'), block_superadmin_user_path(@user), class: "btn btn-error btn-outline btn-sm" %>
    <% end %>
  <% end %>
</div>
