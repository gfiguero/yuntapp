<tr class="hover:bg-base-200/50 cursor-pointer"
    data-controller="row-link"
    data-row-link-url-value="<%= superadmin_user_path(user) %>"
    data-action="click->row-link#visit">
  <td><%= link_to user.id, superadmin_user_path(user), class: "link link-hover font-medium" %></td>
  <td><%= user.email %></td>
  <td>
    <% if user.admin? %>
      <span class="badge badge-success badge-sm">Sí</span>
    <% else %>
      <span class="badge badge-ghost badge-sm">No</span>
    <% end %>
  </td>
  <td>
    <% if user.superadmin? %>
      <span class="badge badge-warning badge-sm">Sí</span>
    <% else %>
      <span class="badge badge-ghost badge-sm">No</span>
    <% end %>
  </td>
  <td><%= user.neighborhood_association&.name || "-" %></td>
  <td><%= l(user.created_at, format: :short) %></td>
  <td class="flex gap-1 items-center">
    <%= link_to I18n.t('actions.edit'), edit_superadmin_user_path(user), class: "btn btn-xs btn-ghost" %>
    <% if user.blocked? %>
      <span class="badge badge-error badge-sm"><%= I18n.t('superadmin.users.block.badge') %></span>
    <% elsif user.deactivated? %>
      <span class="badge badge-ghost badge-sm"><%= I18n.t('superadmin.users.block.deactivated_badge') %></span>
    <% elsif !user.superadmin? %>
      <%= link_to I18n.t('superadmin.users.block.action'), block_superadmin_user_path(user), class: "btn btn-xs btn-error btn-outline" %>
    <% end %>
  </td>
</tr>
