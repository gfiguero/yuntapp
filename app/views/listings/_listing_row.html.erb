<tr class="hover:bg-base-300 cursor-pointer"
    data-controller="row-link"
    data-row-link-url-value="<%= url_for(listing) %>"
    data-action="click->row-link#visit">
  <td><%= link_to listing.name, listing, class: "link link-hover font-medium" %></td>
  <td>
    <div class="tooltip" data-tip="<%= I18n.t('actions.edit') %>">
      <%= link_to icon('edit'), edit_listing_path(listing), class: "btn btn-sm btn-soft btn-success" %>
    </div>
    <div class="tooltip" data-tip="<%= I18n.t('actions.delete') %>">
      <%= link_to icon('delete'), delete_listing_path(listing), class: "btn btn-sm btn-soft btn-warning" %>
    </div>
  </td>
</tr>
