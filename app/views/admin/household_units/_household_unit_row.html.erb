<tr class="hover:bg-base-300 cursor-pointer"
    data-controller="row-link"
    data-row-link-url-value="<%= url_for([:admin, household_unit]) %>"
    data-action="click->row-link#visit">
  <td><%= link_to household_unit.neighborhood_delegation.name, [:admin, household_unit], class: "link link-hover font-medium" %></td>
  <td><%= household_unit.number %></td>
  <td>
    <%= icon_link_to 'edit', edit_admin_household_unit_path(household_unit), I18n.t('actions.edit'), class: "btn btn-sm btn-soft btn-success" %>
  </td>
</tr>
