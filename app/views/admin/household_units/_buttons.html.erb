<div class="flex flex-row gap-2 mb-4">

  <% if %w[ index ].include? action_name %>
    <%= label_tag :filter, raw(icon('filter') + I18n.t('actions.filter')), class: "btn btn-soft" %>
  <% end %>

  <% unless %w[ index ].include? action_name %>
    <%= link_to raw(icon('list') + I18n.t('actions.index')), admin_household_units_path, class: "btn btn-soft" %>
  <% end %>

  <% unless %w[ new create ].include? action_name %>
    <%= link_to raw(icon('new') + I18n.t('actions.new')), new_admin_household_unit_path, class: "btn btn-soft btn-primary" %>
  <% end %>

  <% if %w[ show ].include? action_name %>
    <%= link_to raw(icon('edit') + I18n.t('actions.edit')), edit_admin_household_unit_path(@household_unit), class: "btn btn-soft btn-success" %>
  <% end %>

  <% if %w[ edit update ].include? action_name %>
    <%= link_to raw(icon('cancel') + I18n.t('actions.cancel')), [:admin, @household_unit], class: "btn btn-soft" %>
  <% end %>

</div>
