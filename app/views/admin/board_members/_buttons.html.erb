<div class="flex flex-row gap-2 mb-4">

  <% if %w[ index ].include? action_name %>
    <%= label_tag :filter, raw(icon('filter') + I18n.t('actions.filter')), class: "btn btn-soft" %>
  <% end %>

  <% unless %w[ index ].include? action_name %>
    <%= link_to raw(icon('list') + I18n.t('actions.index')), admin_board_members_path, class: "btn btn-soft" %>
  <% end %>

  <% unless %w[ new create ].include? action_name %>
    <%= link_to raw(icon('new') + I18n.t('actions.new')), new_admin_board_member_path, class: "btn btn-soft btn-primary" %>
  <% end %>

  <% if %w[ show end_term ].include? action_name %>
    <%= link_to raw(icon('edit') + I18n.t('actions.edit')), edit_admin_board_member_path(@board_member), class: "btn btn-soft btn-success" %>
  <% end %>

  <% if %w[ edit update end_term ].include? action_name %>
    <%= link_to raw(icon('cancel') + I18n.t('actions.cancel')), [:admin, @board_member], class: "btn btn-soft" %>
  <% end %>

  <% if %w[ show edit update ].include?(action_name) && @board_member.active? %>
    <%= link_to raw(icon('delete') + I18n.t('admin.board_members.end_term.action')), end_term_admin_board_member_path(@board_member), class: "btn btn-soft btn-warning" %>
  <% end %>

  <% if %w[ end_term ].include? action_name %>
    <%= button_to raw(icon('delete') + I18n.t('actions.confirm')), confirm_end_term_admin_board_member_path(@board_member), method: :patch, class: "btn btn-soft btn-error" %>
  <% end %>

</div>
