<div class="card w-full max-w-md bg-base-100 shadow-xl mx-auto">
  <div class="card-body">
    <h1 class="card-title text-2xl mb-2"><%= t("reactivations.new.title") %></h1>
    <p class="text-sm opacity-70 mb-4"><%= t("reactivations.new.help") %></p>

    <%= form_with url: reactivations_path, method: :post do |f| %>
      <label class="floating-label">
        <%= f.email_field :email, required: true, autofocus: true, class: "input input-bordered w-full", placeholder: t("reactivations.new.email") %>
        <span><%= t("reactivations.new.email") %></span>
      </label>
      <div class="mt-4">
        <%= f.submit t("reactivations.new.submit"), class: "btn btn-primary w-full" %>
      </div>
    <% end %>

    <div class="mt-4 text-center">
      <%= link_to t("reactivations.new.back_to_login"), new_user_session_path, class: "link link-hover text-sm" %>
    </div>
  </div>
</div>
